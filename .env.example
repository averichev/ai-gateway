# Optional listen address (default 0.0.0.0, all IPv4 interfaces).
# Use 127.0.0.1 for a standalone service reachable only from this host.
# APP_HOST=127.0.0.1
# HTTP listen port (default 8080). PORT takes precedence over APP_PORT.
# PORT=8080
# With no DATABASE_URL, SQLite creates ai-gateway.sqlite3 in the working directory.
# DATABASE_URL=sqlite:///var/lib/ai-gateway/ai-gateway.sqlite3
# DATABASE_URL=postgres://ai_gateway:password@127.0.0.1:5432/ai_gateway

# Without an override the gateway creates ai-gateway.key in its working directory.
# Supply the existing 32-byte base64 key when using externally managed secrets.
# GATEWAY_MASTER_KEY=<base64-encoded-32-byte-key>
ADMIN_DIST_DIR=/app/admin/dist

# AI Gateway release channel. Leave empty to disable update checks.
GATEWAY_UPDATE_SOURCE=https://app.releases.veruna.systems/ai-gateway/manifest.json
# Native Linux service only. The Docker image uses external installation.
# GATEWAY_UPDATE_MODE=supervisor
# GATEWAY_UPDATE_DIR=/var/lib/ai-gateway/updater

# Embedded PostgreSQL credentials for Docker installations using PostgreSQL.
# POSTGRES_USER=ai_gateway
# POSTGRES_PASSWORD=replace-me
# POSTGRES_DB=ai_gateway

DEFAULT_PROVIDER_CODE=openai
DEFAULT_PROVIDER_KIND=openai-compatible
DEFAULT_PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_PROVIDER_TIMEOUT_MS=60000
DEFAULT_MODEL_ALIAS=smart-default
DEFAULT_EXTERNAL_MODEL=gpt-4.1-mini

# Opt in only for temporary diagnostics with non-confidential data.
STORE_CONTENT_PREVIEWS=false
REQUEST_PREVIEW_CHARS=1500
RESPONSE_PREVIEW_CHARS=2000
